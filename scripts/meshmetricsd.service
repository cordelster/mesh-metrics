[Unit]
Description=Meshtastic Repeater Telemetry Daemon
Documentation=https://github.com/cordelster/mesh-metrics
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=meshtastic
Group=meshtastic
ExecStart=/usr/local/bin/meshmetricsd --config /etc/meshtastic-telemetry/meshmetricsd.conf
ExecReload=/bin/kill -HUP $MAINPID
PIDFile=/var/run/meshmetricsd.pid
Restart=on-failure
RestartSec=10s

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/meshtastic-telemetry /var/log/meshtastic-telemetry /var/run /var/lib/node_exporter/textfile_collector

# Resource limits
MemoryMax=512M
CPUQuota=50%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=meshmetricsd

[Install]
WantedBy=multi-user.target
