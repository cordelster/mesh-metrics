{
  "name": "Meshtastic Metrics Daemon",
  "version": "0.98.0",
  "slug": "meshmetricsd",
  "description": "Monitor Meshtastic repeater telemetry and export metrics to Prometheus",
  "arch": ["aarch64", "amd64", "armhf", "armv7", "i386"],
  "url": "https://github.com/cordelster/mesh-metrics",
  "startup": "application",
  "boot": "auto",
  "init": false,
  "devices": ["/dev/ttyACM0", "/dev/ttyUSB0"],
  "usb": true,
  "uart": true,
  "devicetree": true,
  "privileged": ["SYS_RAWIO"],
  "map": ["config:rw", "share:rw"],
  "options": {
    "connection_mode": "serial",
    "device_port": "/dev/ttyACM0",
    "poll_interval": 300,
    "dwell_time": 10,
    "log_level": "INFO",
    "output_directory": "/data",
    "output_format": "node_exporter",
    "individual_files": true,
    "atomic_writes": true,
    "devices_list": "!2f67c123,Example Node 1,Location 1,37.7749,-122.4194\n!2c4354f4,Example Node 2,Location 2,37.8044,-122.2712",
    "devices_encrypted": false,
    "devices_password": "",
    "prometheus_push_url": "",
    "prometheus_job_name": "meshtastic_repeater_telemetry",
    "prometheus_instance": "",
    "prometheus_timeout": 30,
    "enable_stats": true
  },
  "schema": {
    "connection_mode": "list(serial|ip)",
    "device_port": "str",
    "poll_interval": "int(60,3600)",
    "dwell_time": "int(5,60)",
    "log_level": "list(DEBUG|INFO|WARNING|ERROR|CRITICAL)",
    "output_directory": "str",
    "output_format": "list(node_exporter)",
    "individual_files": "bool",
    "atomic_writes": "bool",
    "devices_list": "str",
    "devices_encrypted": "bool",
    "devices_password": "password?",
    "prometheus_push_url": "str?",
    "prometheus_job_name": "str",
    "prometheus_instance": "str?",
    "prometheus_timeout": "int(5,120)",
    "enable_stats": "bool"
  },
  "image": "ghcr.io/{arch}-addon-meshmetricsd"
}
